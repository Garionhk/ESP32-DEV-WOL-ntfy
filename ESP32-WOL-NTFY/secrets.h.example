#pragma once

// Copy this file to secrets.h and fill it in. secrets.h is gitignored.
//
//     cp secrets.h.example secrets.h

// ---- WiFi ---------------------------------------------------------------
#define WIFI_SSID       "your-wifi-name"
#define WIFI_PASSWORD   "your-wifi-password"

// ---- ntfy server --------------------------------------------------------
// Works with public ntfy.sh or any self-hosted instance.
//
//   public ntfy.sh:      ntfy.sh              port 443, TLS 1
//   self-hosted HTTPS:   ntfy.example.com     port 443, TLS 1
//   self-hosted plain:   10.0.0.10            port 80,  TLS 0
//
#define NTFY_HOST       "ntfy.sh"
#define NTFY_PORT       443
#define NTFY_USE_TLS    1        // 0 for plain http (LAN servers only)

// ---- ntfy topic ---------------------------------------------------------
// Commands come in on this topic and replies go back out on it.
//
// On an OPEN server (public ntfy.sh with no auth) anyone who knows this name
// can read the whole history -- including the passphrase below -- and can then
// add, remove, and wake at will. There the topic name IS a credential: use a
// long random one, not "eddy-wol". Generate one with:
//
//     openssl rand -hex 8
//
// On a server with access control (below), the topic name matters much less --
// the login is what gates access.
//
#define NTFY_TOPIC      "wol-REPLACE-THIS-BEFORE-USE"

// ---- ntfy login ---------------------------------------------------------
// For servers with auth enabled (auth-file / auth-default-access deny).
// Leave all three empty for an open server.
//
// A token wins if both are set. Create one with:  ntfy token add <user>
// (Comments here deliberately avoid quote marks -- a quoted example in a
// trailing comment trips up naive greedy parsers that scan this file.)
#define NTFY_TOKEN      ""              // example: tk_abc123...

// Username + password login, sent as HTTP Basic on every request.
#define NTFY_USER       ""              // example: esp32
#define NTFY_PASSWORD   ""

// Self-hosted server with a certificate the bundled ISRG roots do not cover
// (a private CA or a self-signed cert)? Paste its CA in PEM form here and it
// will be used instead. Leave commented out for Let's Encrypt, which the
// bundled roots already handle.
//
// #define NTFY_CUSTOM_CA \
//   "-----BEGIN CERTIFICATE-----\n" \
//   "MIID...\n" \
//   "-----END CERTIFICATE-----\n"

// ---- Command passphrase -------------------------------------------------
// Required on "add" and "remove". Sent inline with those commands, so it ends
// up in the topic history -- rotate it if the topic ever leaks.
#define COMMAND_PASSPHRASE  "change-this-passphrase"
